{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyrical Sync",
  "version": "0.6.101",
  "identifier": "com.arisair.lyrical-sync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lyrical Sync",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "resources": ["PrivacyInfo.xcprivacy"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "12.0",
      "dmg": {
        "background": "dmg/dmg-background.png",
        "windowSize": { "width": 700, "height": 520 },
        "appPosition": { "x": 190, "y": 220 },
        "applicationFolderPosition": { "x": 510, "y": 220 }
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
