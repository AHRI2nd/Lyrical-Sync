{
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-read-lrc-file",
    "allow-read-lrc-file-with-hash",
    "allow-write-lrc-file",
    "allow-write-lrc-file-if-unchanged",
    "allow-prepare-audio-stream",
    "allow-cancel-audio-stream-preparation",
    "allow-summarize-audio-stream",
    "allow-revoke-audio-stream",
    "allow-read-audio-metadata",
    "allow-analyze-bpm-prefix",
    "allow-cancel-audio-analysis",
    "allow-write-batch-output",
    "allow-set-models-dir-override",
    "allow-get-models-dir",
    "allow-check-model-files",
    "allow-begin-model-download",
    "allow-download-model",
    "allow-cancel-model-download",
    "allow-delete-model-files",
    "allow-get-python-env-info",
    "allow-download-embedded-python",
    "allow-install-python-packages",
    "allow-run-alignment",
    "allow-cancel-alignment",
    "allow-start-oauth-listener",
    "allow-cancel-oauth-listener",
    "allow-exchange-spotify-token",
    "allow-refresh-spotify-token",
    "allow-has-refresh-token",
    "allow-persist-pending-refresh-token",
    "allow-clear-refresh-token",
    "allow-check-ytdlp",
    "allow-download-ytdlp",
    "allow-cancel-ytdlp-install",
    "allow-ytdlp-load-audio",
    "allow-cancel-ytdlp-load",
    "allow-retain-ytdlp-audio",
    "allow-lrclib-publish",
    "allow-cancel-lrclib-publish",
    "allow-get-now-playing",
    "allow-now-playing-toggle-play-pause",
    "allow-now-playing-seek",
    "deep-link:default",
    "updater:default",
    "process:default"
  ]
}
